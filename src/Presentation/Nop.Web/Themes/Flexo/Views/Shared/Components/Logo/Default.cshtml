@model LogoModel
@using Nop.Core
@using Nop.Services.Themes
@inject IThemeContext themeContext
@{

    var themeName = await themeContext.GetWorkingThemeNameAsync();
}
<a href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)">


    @if (!string.IsNullOrEmpty(Model.LogoPath))
    {
        <img class="not-sticky" width="266" height="80"  alt="@Model.StoreName" src="@Model.LogoPath">
    }
    else
    {
        <img class="not-sticky" width="266" height="80"  alt="@Model.StoreName" src="~/Themes/@(themeName)/Content/images/logo.png" />
    }
    @if (Model.CustomProperties.ContainsKey("stickyLogoUrl"))
    {

        <img class="sticky-logo" width="177" height="53"  alt="@Model.StoreName" src="@Model.CustomProperties["stickyLogoUrl"].ToString()" />
    }
    else
    {
        <img class="sticky-logo" width="177" height="53"  alt="@Model.StoreName" src="~/Themes/@(themeName)/Content/images/logo-light.png" />
    }
</a>
